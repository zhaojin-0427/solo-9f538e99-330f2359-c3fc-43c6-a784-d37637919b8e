FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SOURCE_PORT=9001

WORKDIR /app

COPY mock_source ./mock_source

EXPOSE 9001

HEALTHCHECK --interval=10s --timeout=3s --start-period=3s --retries=5 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9001/health', timeout=2).status==200 else 1)"

CMD ["python", "-m", "mock_source.server"]
